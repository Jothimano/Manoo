        "def search(arr, n, x):\n",
        "    for i in range(0, n):\n",
        "        if arr[i] == x:\n",
        "            return i\n",
        "    return -1\n",
        "\n",
        "\n",
        "arr = [2, 3, 4, 10, 40]\n",
        "x = 10\n",
        "n = len(arr)\n",
        "\n",
        "result = search(arr, n, x)\n",
        "\n",
        "if result == -1:\n",
        "    print(\"Element is not present in array\")\n",
        "else:\n",
        "    print(\"Element is present at index\", result)\n"
      ]
    },
    {
