      "source": [
        "class Node:\n",
        "    def __init__(self, data):\n",
        "        self.data = data\n",
        "        self.next = None\n",
        "\n",
        "\n",
        "class CircularLinkedList:\n",
        "    def __init__(self):\n",
        "        self.head = None\n",
        "\n",
        "    def push(self, data):\n",
        "        ptr1 = Node(data)\n",
        "        temp = self.head\n",
        "\n",
        "        ptr1.next = self.head\n",
        "\n",
        "        if self.head is not None:\n",
        "            while temp.next != self.head:\n",
        "                temp = temp.next\n",
        "\n",
        "            temp.next = ptr1\n",
        "        else:\n",
        "            ptr1.next = ptr1\n",
        "\n",
        "        self.head = ptr1\n",
        "\n",
        "    def printList(self):\n",
        "        temp = self.head\n",
        "\n",
        "        if self.head is not None:\n",
        "            while True:\n",
        "                print(temp.data, end=\" \")\n",
        "                temp = temp.next\n",
        "\n",
        "                if temp == self.head:\n",
        "                    break\n",
        "\n",
        "            print()\n",
        "\n",
        "\n",
        "# Create circular linked list\n",
        "cllist = CircularLinkedList()\n",
        "\n",
        "cllist.push(12)\n",
        "cllist.push(56)\n",
        "cllist.push(2)\n",
        "cllist.push(11)\n",
        "\n",
        "print(\"Contents of circular Linked List:\")\n",
        "cllist.printList()\n"
