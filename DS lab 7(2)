        "INT_MIN = -2**32\n",
        "\n",
        "def canRepresentBST(pre):\n",
        "    s = []\n",
        "    root = INT_MIN\n",
        "    for value in pre:\n",
        "        # If we find a node who is on left side and smaller than root, return False\n",
        "        if value < root:\n",
        "            return False\n",
        "\n",
        "        # Nodes greater than stack top means we are now on right subtree,\n",
        "        # update root to last popped item\n",
        "        while len(s) > 0 and s[-1] < value:\n",
        "            root = s.pop()\n",
        "\n",
        "        s.append(value)\n",
        "    return True\n",
        "\n",
        "pre1 = [40, 30, 35, 80, 100]\n",
        "print(\"true\" if canRepresentBST(pre1) else \"false\")\n",
        "\n",
        "pre2 = [40, 30, 35, 20, 80, 100]\n",
        "print(\"true\" if canRepresentBST(pre2) else \"false\")\n"
